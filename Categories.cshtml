@model List<CategoryVm>
<h1>Categories — @ViewBag.Event?.Name</h1>
<div class="cards">@foreach (var category in Model) { <article><h2>@category.Name</h2><p>@category.EnrolledCount entries</p><form method="post" asp-action="UpdateCategory" asp-route-eventId="@ViewBag.EventId" asp-route-categoryId="@category.Id"><label>Name</label><input name="Name" value="@category.Name" required maxlength="80" /><label>Description</label><input name="Description" value="@category.Description" /><label>Distance (km)</label><input name="DistanceKm" type="number" min="0.1" step="0.1" value="@category.DistanceKm" required /><label>Price</label><input name="Price" type="number" min="0" step="0.01" value="@category.Price" required /><label>Capacity (blank for unlimited)</label><input name="Capacity" type="number" min="1" value="@category.Capacity" /><button class="btn">Update category</button></form><form method="post" asp-action="DeleteCategory" asp-route-eventId="@ViewBag.EventId" asp-route-categoryId="@category.Id"><button class="danger">Delete category</button></form></article> }</div>
<h2>Add category</h2><form method="post" asp-action="CreateCategory" asp-route-eventId="@ViewBag.EventId">
<div asp-validation-summary="All" class="error"></div><label>Name</label><input name="Name" required maxlength="80" /><label>Description</label><input name="Description" /><label>Distance (km)</label><input name="DistanceKm" type="number" min="0.1" step="0.1" value="5" required /><label>Price</label><input name="Price" type="number" min="0" step="0.01" value="0" required /><label>Capacity (leave blank for unlimited)</label><input name="Capacity" type="number" min="1" /><button class="btn">Add category</button></form>
