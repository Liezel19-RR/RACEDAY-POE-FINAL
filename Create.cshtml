@model CreateEventVm
<h1>Create an event</h1><form method="post" asp-action="Create"><div asp-validation-summary="All" class="error"></div><label asp-for="Name"></label><input asp-for="Name"/><label asp-for="Description"></label><textarea asp-for="Description"></textarea><label asp-for="Date"></label><input asp-for="Date" type="date"/><label asp-for="Location"></label><input asp-for="Location"/><label asp-for="DistanceKm"></label><input asp-for="DistanceKm" type="number" step="0.1"/><label asp-for="EventType"></label><select asp-for="EventType"><option>Run</option><option>Walk</option><option>Cycle</option></select><button class="btn">Save event</button></form>