<!DOCTYPE html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>RaceDay</title><link rel="stylesheet" href="~/css/site.css" /></head><body><header><a class="brand" asp-controller="Home" asp-action="Index">RaceDay</a><nav><a asp-controller="Events" asp-action="Index">Events</a>@if(Context.Session.GetString(SessionKeys.Role)=="Organiser"){<a asp-controller="Organiser" asp-action="Dashboard">Dashboard</a><a asp-controller="Events" asp-action="Create">Create event</a>}@if(Context.Session.GetString(SessionKeys.Role)=="Participant"){<a asp-controller="Participant" asp-action="MyEvents">My events</a><a asp-controller="Participant" asp-action="Results">Results</a><a asp-controller="Account" asp-action="Profile">Profile</a>}@if(Context.Session.GetString(SessionKeys.Role)!=null){<form method="post" asp-controller="Account" asp-action="Logout"><button class="link-button">Logout</button></form>}else{<a asp-controller="Account" asp-action="Login">Login</a><a asp-controller="Account" asp-action="Register">Register</a>}</nav></header><main>@if(TempData["Message"]!=null){<p class="notice">@TempData["Message"]</p>}@RenderBody()</main><footer>RaceDay · Run. Walk. Cycle.</footer><script src="~/js/site.js"></script></body></html>